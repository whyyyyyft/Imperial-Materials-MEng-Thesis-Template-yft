@article{xiaoAccuratePredictionSecond2024,
	title = {Accurate prediction of second harmonic generation coefficients using graph neural networks},
	volume = {244},
	issn = {0927-0256},
	url = {https://www.sciencedirect.com/science/article/pii/S0927025624004245},
	doi = {10.1016/j.commatsci.2024.113203},
	abstract = {Nonlinear optical materials are critical for the application of all-solid-state lasers in the mid-infrared spectral region. However, practical materials are still lacking. Experiments and first-principles calculations of second harmonic generation (SHG) coefficients are costly and time-consuming. The existing machine learning method for predicting SHG coefficients is limited to specific crystal structures and requires complex feature engineering. Graph neural networks (GNNs) can automatically extract features from crystal structures, achieving state-of-the-art performance for many material properties. Here, we construct a SHG coefficient dataset and develop a GNN-based model to predict SHG coefficients quickly. To obtain more complete information, we design bond angle feature, global feature, and global attention pooling layer for graph isomorphic network with high discriminative power. In addition, transfer learning is introduced to improve the generalization ability. Based on these extensions, the proposed model exhibits superior performance over seven competing models. We also offer a clear explanation by visualizing the attention scores. This study provides a promising direction for the development of effective prediction models for SHG coefficients.},
	urldate = {2025-12-05},
	journal = {Computational Materials Science},
	author = {Xiao, Jianping and Yang, Li and Wang, Shuqun and He, Zhiyu},
	month = sep,
	year = {2024},
	keywords = {Chalcogenides, Graph neural network, Second harmonic generation coefficient},
	pages = {113203},
}

@article{duanFirstprinciplesCalculationSecondharmonicgeneration1999,
	title = {First-principles calculation of the second-harmonic-generation coefficients of borate crystals},
	volume = {60},
	url = {https://link.aps.org/doi/10.1103/PhysRevB.60.9435},
	doi = {10.1103/PhysRevB.60.9435},
	abstract = {We report the calculation of the second-harmonic-generation (SHG) coefficients of LiB3⁢O5 (LBO), CsB3⁢O5 (CBO), and BaB2⁢O4 (BBO) using the linearized augmented plane-wave band method in the local-density approximation with a scissors operator that includes the renormalization of the momentum operator. The analysis that is based on the spectral and spatial decomposition of the calculated results reveals that, for the large component of SHG coefficients, the dominant source of the optical nonlinearities for these borate crystals is the nonlinear response of the high-lying 2⁢𝑝 electrons of oxygen atoms, while the cations play a minor role even in the heavier Cs and Ba cases, though they dominate the conduction-band minimum. But for the small SHG component, the role of the cation became important, particularly when the isolated anionic group has little contribution due to the restriction of the symmetry. In the case of LBO and CBO, due to the linkage of anionic groups, the contributions of off-ring O atoms are almost the same as those of in-ring O atoms. Yet for BBO where there is no such linkage, the off-ring O atom plays a much more important role than the in-ring O atom does. We also find that the contribution of the virtual-hole process cannot be ignored as is usually done in the semiconductors case.},
	number = {13},
	urldate = {2025-12-05},
	journal = {Physical Review B},
	publisher = {American Physical Society},
	author = {Duan, Chun-gang and Li, Jun and Gu, Zong-quan and Wang, Ding-sheng},
	month = oct,
	year = {1999},
	pages = {9435--9443},
}

