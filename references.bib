@article{zwanzigerFiniteHomogeneousElectric2012,
	title = {Finite homogeneous electric fields in the projector augmented wave formalism: {Applications} to linear and nonlinear response},
	volume = {58},
	issn = {0927-0256},
	shorttitle = {Finite homogeneous electric fields in the projector augmented wave formalism},
	url = {https://www.sciencedirect.com/science/article/pii/S0927025612000559},
	doi = {10.1016/j.commatsci.2012.01.028},
	abstract = {Computation of the effect of finite homogeneous electric fields in periodic systems is described in the context of the projector augmented wave formalism. Generalizing previous norm-conserving implementations, we compute the polarization using the approach of King-Smith and Vanderbilt [Phys. Rev. B 47 (1993) 1651] fully within the projector augmented wave framework, and then minimizing the electric field enthalpy. Applications to simple systems are provided, including both linear and nonlinear field effects, and photoelastic response.},
	urldate = {2025-12-04},
	journal = {Computational Materials Science},
	author = {Zwanziger, J. W. and Galbraith, J. and Kipouros, Y. and Torrent, M. and Giantomassi, M. and Gonze, X.},
	month = jun,
