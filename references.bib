@article{naikUltraflatbandsShearSolitons2018,
	title = {Ultraflatbands and {Shear} {Solitons} in {Moir}{\textbackslash}'e {Patterns} of {Twisted} {Bilayer} {Transition} {Metal} {Dichalcogenides}},
	volume = {121},
	url = {https://link.aps.org/doi/10.1103/PhysRevLett.121.266401},
	doi = {10.1103/PhysRevLett.121.266401},
	abstract = {Ultraflatbands in twisted bilayers of two-dimensional materials have the potential to host strong correlations, including the Mott-insulating phase at half-filling of the band. Using first-principles density functional theory calculations, we show the emergence of ultraflatbands at the valence band edge in twisted bilayer MoS2, a prototypical transition metal dichalcogenide. The computed band widths, 5 and 23 meV for 56.5° and 3.5° twist angles, respectively, are comparable to that of twisted bilayer graphene near “magic” angles. Large structural transformations in the moiré patterns lead to formation of shear solitons at stacking boundaries and strongly influence the electronic structure. We extend our analysis for twisted bilayer MoS2 to show that flatbands can occur at the valence band edge of twisted bilayer WS2, MoSe2, and WSe2 as well.},
	number = {26},
	urldate = {2026-05-06},
	journal = {Physical Review Letters},
	publisher = {American Physical Society},
	author = {Naik, Mit H. and Jain, Manish},
	month = dec,
	year = {2018},
	pages = {266401},
}

