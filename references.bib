	title = {Crucial role of atomic corrugation on the flat bands and energy gaps of twisted bilayer graphene at the magic angle \${\textbackslash}ensuremath\{{\textbackslash}theta\}{\textbackslash}ensuremath\{{\textbackslash}sim\}1.\{08\}{\textasciicircum}\{{\textbackslash}ensuremath\{{\textbackslash}circ\}\}\$},
