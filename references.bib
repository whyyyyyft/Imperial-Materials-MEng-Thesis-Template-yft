@article{chenBroadeningCloakingBandwidth2013,
	title = {Broadening the {Cloaking} {Bandwidth} with {Non}-{Foster} {Metasurfaces}},
	volume = {111},
	url = {https://link.aps.org/doi/10.1103/PhysRevLett.111.233001},
