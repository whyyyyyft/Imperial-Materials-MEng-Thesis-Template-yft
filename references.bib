	keywords = {Air gaps, Antenna accessories, Antenna feeds, Degradation, Europe, Insertion loss, Loss measurement, Mutual coupling, Radar, Radar antennas, millimeter (mm)-wave, radar antennas, waveguide components},
	pages = {397--400},
}

@inproceedings{kangPhaseCalculationDiffraction2023,
	title = {Phase calculation of diffraction grating based on {RCWA}},
	volume = {12768},
	url = {https://www.spiedigitallibrary.org/conference-proceedings-of-spie/12768/127681T/Phase-calculation-of--diffraction-grating-based-on-RCWA/10.1117/12.2687137.full},
	doi = {10.1117/12.2687137},
	abstract = {The diffraction grating is an important optical component in the field of optics, used in various optical instruments. Therefore, researching and analyzing the characteristics of gratings holds great significance. RCWA (Rigorous Coupled-Wave Analysis) is an electromagnetic field solving algorithm applied to periodic structures and is an important tool for grating analysis. This paper proposes a diffraction grating phase calculation method based on RCWA. Using a one-dimensional rectangular aluminum metal grating as an example, it calculates the phase of the incident light after encountering the grating and compares the phase calculation results with those obtained from the KAPPA software. Based on the phase calculation, we propose a method for characterizing grating morphology and detecting defects using the principle of phase change after light passes through the grating, offering new possibilities for grating fabrication quality control.},
	urldate = {2025-12-09},
	booktitle = {Holography, {Diffractive} {Optics}, and {Applications} {XIII}},
