	title = {Bloch mode analysis of subwavelength polarizing planar optics},
	volume = {12432},
	url = {https://www.spiedigitallibrary.org/conference-proceedings-of-spie/12432/1243204/Bloch-mode-analysis-of-subwavelength-polarizing-planar-optics/10.1117/12.2646194.full},
