@article{liOutInplaneMagnetic2014,
	title = {Out- versus in-plane magnetic anisotropy of free {Fe} and {Co} nanocrystals: {Tight}-binding and first-principles studies},
	volume = {90},
	shorttitle = {Out- versus in-plane magnetic anisotropy of free {Fe} and {Co} nanocrystals},
	url = {https://link.aps.org/doi/10.1103/PhysRevB.90.205409},
	doi = {10.1103/PhysRevB.90.205409},
	abstract = {We report tight-binding and density functional theory calculations of magnetocrystalline anisotropy energy (MAE) of free Fe (body-centered-cubic) and Co (face-centered-cubic) slabs and nanocrystals. The nanocrystals are truncated square pyramids which can be grown experimentally by deposition of metal on a SrTiO3(001) substrate. For both elements our local analysis shows that the total MAE of the nanocrystals is largely dominated by the contribution of (001) facets. However, while the easy axis of Fe⁡(001) is out-of-plane, it is in-plane for Co⁡(001). This has direct consequences on the magnetic reversal mechanism of the nanocrystals. Indeed, the very high uniaxial anisotropy of Fe nanocrystals makes them a much better potential candidate for magnetic storage devices.},
	number = {20},
	urldate = {2024-10-11},
	journal = {Physical Review B},
	publisher = {American Physical Society},
	author = {Li, Dongzhe and Barreteau, Cyrille and Castell, Martin R. and Silly, Fabien and Smogunov, Alexander},
	month = nov,
	year = {2014},
	keywords = {MAE},
	pages = {205409},
}

@article{shirodkarEmergenceFerroelectricityMetalSemiconductor2014,
	title = {Emergence of {Ferroelectricity} at a {Metal}-{Semiconductor} {Transition} in a \${1T}\$ {Monolayer} of \$\{{\textbackslash}mathrm\{{MoS}\}\}\_\{2\}\$},
	volume = {112},
	url = {https://link.aps.org/doi/10.1103/PhysRevLett.112.157601},
	doi = {10.1103/PhysRevLett.112.157601},
	abstract = {Using a combination of Landau theoretical analysis and first-principles calculations, we establish a spontaneous symmetry breaking of the metallic state of the 1⁢𝑇 monolayer of MoS2 that opens up a band gap and leads to an unexpected yet robust ferroelectricity with ordering of electric dipoles perpendicular to its plane. Central to the properties of this thinnest known ferroelectric is a strong coupling of conducting states with valley phonons that induce an effective electric field. The current in a semiconducting 1⁢𝑇−MoS2 channel can, thus, be controlled independently by changing its ferroelectric dipolar structure with a gate field, opening up a possibility of a class of nanoscale dipolectronic devices. Our analysis applies equally well to MoSe2, WS2, and WSe2, giving tunability in design of such devices based on two-dimensional chalcogenides.},
	number = {15},
	urldate = {2024-10-11},
	journal = {Physical Review Letters},
	publisher = {American Physical Society},
	author = {Shirodkar, Sharmila N. and Waghmare, Umesh V.},
	month = apr,
	year = {2014},
	keywords = {MoS2, ferroelectricity},
	pages = {157601},
}
